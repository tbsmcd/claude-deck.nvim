#!/bin/sh
# Inspect other claude-terminals terminals. Works only inside a claude-terminals terminal.
#   ct list                 list terminals
#   ct read <id> [count]    recent conversation of a terminal (default 20 messages)
usage() {
    sed -n '3,4p' "$0" | sed 's/^# //' >&2
    exit 1
}

[ -n "$NVIM" ] || { echo "ct: run this inside a claude-terminals terminal" >&2; exit 1; }

is_number() {
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
}

case "$1" in
list)
    self="${CLAUDE_TERMINALS_ID:-0}"
    is_number "$self" || self=0
    expr="v:lua.require'claude-terminals.cli'.list($self)"
    ;;
read)
    id="${2#\#}"
    count="${3:-20}"
    is_number "$id" && is_number "$count" || usage
    expr="v:lua.require'claude-terminals.cli'.read($id,$count)"
    ;;
*)
    usage
    ;;
esac

out=$(nvim --server "$NVIM" --remote-expr "$expr") || exit 1
printf '%s\n' "$out"
case "$out" in "ct: "*) exit 1 ;; esac
