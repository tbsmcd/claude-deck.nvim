#!/bin/sh
# Inspect other claude-deck terminals, name this one and open files in the editor. Works only
# inside a claude-deck terminal.
#   ct list                      list terminals
#   ct read <id> [count]         recent conversation of a terminal (default 20 messages)
#   ct title [title]             set the task title of this terminal (show it without a title)
#   ct title --force <title>     also replace a title set by the user (the title is required)
#   ct open <path>[:line]        open a file in the editor of focus mode (path relative to the cwd)
usage() {
    sed -n '4,8p' "$0" | sed 's/^# //' >&2
    exit 1
}

[ -n "$NVIM" ] || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }

is_number() {
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
}

case "$1" in
list)
    self="${CLAUDE_DECK_ID:-0}"
    is_number "$self" || self=0
    expr="v:lua.require'claude-deck.cli'.list($self)"
    ;;
read)
    id="${2#\#}"
    count="${3:-20}"
    is_number "$id" && is_number "$count" || usage
    expr="v:lua.require'claude-deck.cli'.read($id,$count)"
    ;;
title)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    force=v:false
    if [ "${1-}" = --force ]; then
        force=v:true
        shift
        [ $# -gt 0 ] || usage
    fi
    [ "${1-}" = -- ] && shift
    if [ $# -eq 0 ]; then
        expr="v:lua.require'claude-deck.cli'.title($self)"
    else
        # Pass the title as a "\xHH…" string so that quotes, backslashes and newlines are safe
        hex=$(printf '%s' "$*" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
        expr="v:lua.require'claude-deck.cli'.title($self,\"$hex\",$force)"
    fi
    ;;
open)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    [ "${1-}" = -- ] && shift
    [ $# -gt 0 ] || usage
    # Passed as "\xHH…" strings like the title. Relative paths are relative to $PWD (Claude's
    # shell may have changed directory since the terminal started).
    hex=$(printf '%s' "$*" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    pwd_hex=$(printf '%s' "${PWD-}" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    expr="v:lua.require'claude-deck.cli'.open($self,\"$hex\",\"$pwd_hex\")"
    ;;
*)
    usage
    ;;
esac

out=$(nvim --server "$NVIM" --remote-expr "$expr") || exit 1
printf '%s\n' "$out"
case "$out" in "ct: "*) exit 1 ;; esac
