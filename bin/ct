#!/bin/sh
# Inspect other claude-deck terminals, name this one and open files in the editor. Works only
# inside a claude-deck terminal.
#   ct list                      list terminals
#   ct read <id> [count]         recent conversation of a terminal (default 20 messages)
#   ct title [title]             set the task title of this terminal (show it without a title)
#   ct title --force <title>     also replace a title set by the user (the title is required)
#   ct open <path>[:line]        open a file in the editor of focus mode (path relative to the cwd)
#   ct list --json               the same as JSON (one object)
#   ct spawn [--title <title>] [--cwd <dir>] [--model <model>] (--prompt <text> | --prompt-file <path>) [--show]
#                                start a new Claude Code session in a hidden terminal; prints its id as JSON
#   ct send <id> (--prompt <text> | --prompt-file <path>)
#                                type a task into an idle or waiting terminal; prints {"id", "request"}
#   ct wait <id>... [--timeout <seconds>]
#                                wait until the requests sent to those terminals have finished (default 600 s);
#                                exit 0 only means the wait finished (2 = timed out): read each terminal's
#                                "status" (done, attention, exited, missing, none, lost; pending after a timeout)
#   ct diff [<path>[:line]] [--pr <number>] [--base <ref>]
#                                open the diff of the pull request (or the uncommitted changes) there
usage() {
    sed -n '4,19p' "$0" | sed 's/^# //' >&2
    exit 1
}

[ -n "$NVIM" ] || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }

is_number() {
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
}

case "$1" in
list)
    self="${CLAUDE_DECK_ID:-0}"
    is_number "$self" || self=0
    json=v:false
    if [ "${2-}" = --json ]; then
        json=v:true
    fi
    expr="v:lua.require'claude-deck.cli'.list($self,$json)"
    ;;
read)
    id="${2#\#}"
    count="${3:-20}"
    is_number "$id" && is_number "$count" || usage
    expr="v:lua.require'claude-deck.cli'.read($id,$count)"
    ;;
title)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    force=v:false
    if [ "${1-}" = --force ]; then
        force=v:true
        shift
        [ $# -gt 0 ] || usage
    fi
    [ "${1-}" = -- ] && shift
    if [ $# -eq 0 ]; then
        expr="v:lua.require'claude-deck.cli'.title($self)"
    else
        # Pass the title as a "\xHH…" string so that quotes, backslashes and newlines are safe
        hex=$(printf '%s' "$*" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
        expr="v:lua.require'claude-deck.cli'.title($self,\"$hex\",$force)"
    fi
    ;;
open)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    [ "${1-}" = -- ] && shift
    [ $# -gt 0 ] || usage
    # Passed as "\xHH…" strings like the title. Relative paths are relative to $PWD (Claude's
    # shell may have changed directory since the terminal started).
    hex=$(printf '%s' "$*" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    pwd_hex=$(printf '%s' "${PWD-}" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    expr="v:lua.require'claude-deck.cli'.open($self,\"$hex\",\"$pwd_hex\")"
    ;;
diff)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    # Each argument as a "\xHH…" string in a list
    list=""
    for arg in "$@"; do
        hex=$(printf '%s' "$arg" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
        list="$list\"$hex\","
    done
    pwd_hex=$(printf '%s' "${PWD-}" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    expr="v:lua.require'claude-deck.cli'.diff($self,[$list],\"$pwd_hex\")"
    ;;
spawn)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    list=""
    for arg in "$@"; do
        hex=$(printf '%s' "$arg" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
        list="$list\"$hex\","
    done
    pwd_hex=$(printf '%s' "${PWD-}" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    expr="v:lua.require'claude-deck.cli'.spawn($self,[$list],\"$pwd_hex\")"
    ;;
send)
    self="$CLAUDE_DECK_ID"
    is_number "$self" || { echo "ct: run this inside a claude-deck terminal" >&2; exit 1; }
    shift
    target="${1#\#}"
    is_number "$target" || usage
    shift
    list=""
    for arg in "$@"; do
        hex=$(printf '%s' "$arg" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
        list="$list\"$hex\","
    done
    pwd_hex=$(printf '%s' "${PWD-}" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')
    expr="v:lua.require'claude-deck.cli'.send($self,$target,[$list],\"$pwd_hex\")"
    ;;
wait)
    shift
    timeout=600
    ids=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --timeout)
            [ $# -ge 2 ] || usage
            timeout="$2"
            shift 2
            ;;
        --timeout=*)
            timeout="${1#--timeout=}"
            shift
            ;;
        *)
            id="${1#\#}"
            is_number "$id" || usage
            ids="$ids${ids:+,}$id"
            shift
            ;;
        esac
    done
    [ -n "$ids" ] || usage
    is_number "$timeout" || usage
    deadline=$(($(date +%s) + timeout))
    timed_out=v:false
    while :; do
        status=$(nvim --server "$NVIM" --remote-expr "v:lua.require'claude-deck.cli'.wait_status([$ids])") || exit 1
        case "$status" in "ct: "*) printf '%s\n' "$status"; exit 1 ;; esac
        echo "$status" | grep -q ' pending' || break
        if [ "$(date +%s)" -ge "$deadline" ]; then
            timed_out=v:true
            break
        fi
        sleep 1
    done
    out=$(nvim --server "$NVIM" --remote-expr "v:lua.require'claude-deck.cli'.wait_result([$ids],$timed_out)") || exit 1
    printf '%s\n' "$out"
    [ "$timed_out" = v:false ] || exit 2
    exit 0
    ;;
*)
    usage
    ;;
esac

out=$(nvim --server "$NVIM" --remote-expr "$expr") || exit 1
printf '%s\n' "$out"
case "$out" in "ct: "*) exit 1 ;; esac
